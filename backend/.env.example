# ====================================================
# PlotPin Platform Production Environment Configuration
# ====================================================

NODE_ENV=production
PORT=5000

# Supabase PostgreSQL & Auth Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Cryptographic Session Secrets
JWT_ACCESS_SECRET=your_super_strong_jwt_access_secret_2026
JWT_REFRESH_SECRET=your_super_strong_jwt_refresh_secret_2026

# Production Frontend URL (e.g., https://plotpin.vercel.app or your custom domain)
FRONTEND_URL=http://localhost:5173

# Email Delivery Configuration (Choose One)
# Option A: Gmail SMTP with App Password
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_gmail_app_password

# Option B: Resend API (Free tier at resend.com)
RESEND_API_KEY=re_your_api_key_here

# Option C: Standard SMTP (SendGrid, Brevo, AWS SES)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_password

# ====================================================
# Redis & High-Performance Cache Configuration
# ====================================================
# Optional: Redis connection URL (supports redis:// and rediss:// for Upstash/Render/AWS ElastiCache)
# If omitted or offline, PlotPin automatically falls back to In-Memory TTL caching without crashing.
REDIS_URL=redis://default:your_redis_password@your-redis-host.com:6379
# Alternatively:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_ENABLED=true
